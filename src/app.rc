#include <windows.h>
#pragma code_page(65001)
1 ICON "assets/baozi.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "包子PDF - Windows native PDF reader\0"
   VALUE "FileVersion", "1.0.0\0"
   VALUE "ProductName", "包子PDF\0"
   VALUE "ProductVersion", "1.0.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
101 DIALOGEX 0,0,270,92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "打开加密 PDF"
FONT 10,"Microsoft YaHei UI"
BEGIN
 LTEXT "请输入文档密码（仅用于本次打开，不保存）：",-1,12,12,248,12
 EDITTEXT 1001,12,31,246,16,ES_PASSWORD | ES_AUTOHSCROLL
 DEFPUSHBUTTON "打开",IDOK,139,62,56,18
 PUSHBUTTON "取消",IDCANCEL,202,62,56,18
END
